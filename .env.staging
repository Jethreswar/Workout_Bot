# Staging Environment
NODE_ENV=staging
PORT=4000
MONGO_URI=mongodb://staging_user:staging_password@mongodb:27017/workout_tracker_staging?authSource=admin
GEMINI_API_KEY=${GEMINI_API_KEY}

# CORS Settings
CORS_ORIGIN=http://localhost:3001

# JWT Settings
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=900000

# Logging
LOG_LEVEL=info