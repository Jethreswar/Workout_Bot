# Development Environment
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://root:password@localhost:27017/workout_tracker?authSource=admin
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Settings
CORS_ORIGIN=http://localhost:3000

# JWT Settings (if you plan to add authentication)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Logging
LOG_LEVEL=debug